# Public origin for canonical tags, og:url, og:image, sitemap, robots and JSON-LD.
#
# Optional. Resolution order (src/lib/site.ts):
#   NEXT_PUBLIC_SITE_URL  ->  VERCEL_PROJECT_PRODUCTION_URL  ->  http://localhost:3000
